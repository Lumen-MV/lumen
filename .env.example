# Copy to .env.local (dev, Windows) or .env (VM). Never commit real values.
# infra/deploy.sh refuses to run while any of APP_URL, APP_DOMAIN, ACME_EMAIL, SESSION_SECRET, ADMIN_USERNAME, ADMIN_PASSWORD is empty.
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
# Public base URL; used to build invite links, the login link and Stremio manifest URLs (VM: https://<APP_DOMAIN>)
APP_URL=http://localhost:3000
# VM only — Caddy obtains the Let's Encrypt certificate for this host name (the DNS A record must point at the VM)
APP_DOMAIN=
# VM only — Let's Encrypt sends certificate warnings here
ACME_EMAIL=

# 32+ random characters; encrypts the lumen_session cookie (Git Bash: openssl rand -base64 48)
SESSION_SECRET=
# First admin account, created on boot if no admin exists
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_DISPLAY_NAME=Admin

# Catalog / sources (Phase 2-3)
TMDB_READ_TOKEN=
TORBOX_API_KEY=
TORRENTIO_BASE=https://torrentio.strem.fun

# Subtitles (Phase 5)
OPENSUBTITLES_API_KEY=
OPENSUBTITLES_USER=
OPENSUBTITLES_PASS=
SUBDL_API_KEY=

# AI translation (Phase 5): kie | deepseek | claude
TRANSLATOR=kie
KIE_API_KEY=
KIE_BASE_URL=https://api.kie.ai
KIE_MODEL=deepseek-v4-1-flash
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
ANTHROPIC_API_KEY=

# ffmpeg only for embedded-subtitle extraction (Phase 5). Windows dev example: C:\ffmpeg\bin\ffmpeg.exe
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# SQLite + subs/jobs/backups live here (Docker: /data volume)
DATA_DIR=./data
MAX_CONCURRENT_VIEWERS=5
MAX_CLOUD_JOBS=6
DEFAULT_QUALITY=1080p
# direct = <video>/Stremio get the TorBox CDN URL (VM egress ≈ 0, the URL embeds the TorBox key → rotate it when a member leaves)
# proxy  = video is piped through the VM (key never leaves the server, ~2–4 GB egress per film)
STREAM_MODE=direct

# 1 only in dev: enables lumen_scenario cookie flags, /dev/ui and /api/dev/*
LUMEN_SCENARIOS=0
# 1 = background title_sources sweeper + nightly backup + daily new-episode check (0 for QA runs that must not call TorBox)
LUMEN_SWEEPER=1
# 1 only behind a proxy that rewrites x-forwarded-for (docker-compose sets it for Caddy); 0 = ignore forwarded headers
TRUST_PROXY=0
APP_VERSION=1.0
